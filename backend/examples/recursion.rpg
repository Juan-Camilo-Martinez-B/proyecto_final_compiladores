// Factorial y Fibonacci con recursión (RPGScript no tiene ciclos)
func factorial(int n) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

func fibonacci(int n) -> int {
    if (n < 2) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

int f5 = factorial(5);
int fib10 = fibonacci(10);
print(f5);
print(fib10);
