// Índice de masa corporal (IMC) y temperatura
float peso = 68.5;
float estatura = 1.72;
int temperatura_c = 38;

func imc(float kilos, float metros) -> float {
    return kilos / (metros * metros);
}

func a_fahrenheit(int celsius) -> float {
    return celsius * 9.0 / 5.0 + 32.0;
}

float indice = imc(peso, estatura);
if (indice < 18.5) {
    print("Bajo peso");
} else {
    if (indice < 25.0) {
        print("Peso normal");
    } else {
        print("Sobrepeso");
    }
}

bool fiebre = temperatura_c >= 38;
if (fiebre) {
    print("Tiene fiebre");
}
print(a_fahrenheit(temperatura_c));
